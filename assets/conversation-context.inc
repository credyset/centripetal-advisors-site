<section id="conversation-context" class="ca-contact-context" aria-label="Conversation context" hidden>
  <label for="conversation-topic">What would you like to work through?</label>
  <select id="conversation-topic" name="ConversationTopic">
    <option value="general">A finance question</option>
    <option value="finance-leadership">Finance leadership</option>
    <option value="fundraising">Fundraising preparation</option>
    <option value="cash-runway">Cash and runway planning</option>
    <option value="board-reporting">Board and investor reporting</option>
    <option value="venture-debt">Venture debt</option>
    <option value="finance-operations">Treasury and finance operations</option>
    <option value="finance-foundation">Finance Scorecard priorities</option>
  </select>
  <p data-context-intro>Start with the decision in front of you and the finance work behind it.</p>
  <details><summary>Useful context for the conversation</summary><ul data-context-prompts></ul></details>
  <button data-add-prompts type="button">Add prompts to my message</button>
  <p class="ca-context-status" data-context-status role="status"></p>
  <a data-context-back hidden></a>
  <p id="ca-context-note" class="ca-context-note">Concept preview. Messages are not sent or saved. A short description is enough; no financial documents are needed here.</p>
</section>
